---
import Base from '../../layouts/Base.astro';
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://www.afrirank.fr/en/contact/",
      "name": "Contact — AfriRank",
      "url": "https://www.afrirank.fr/en/contact/",
      "inLanguage": "en",
      "isPartOf": { "@id": "https://www.afrirank.fr/#website" },
      "about": { "@id": "https://www.afrirank.fr/#business" }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.afrirank.fr/#business",
      "name": "AfriRank",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@advised-seo.fr",
        "availableLanguage": ["en", "fr"],
        "areaServed": ["GB", "US", "FR", "Europe"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.afrirank.fr/en/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.afrirank.fr/en/contact/" }
      ]
    }
  ]
});
---
<Base title="Contact — AfriRank | Book your SEO Diagnostic" description="Let's spend 30 minutes on your brand and your organic potential. Book a call or write to AfriRank." active="contact" jsonLd={jsonLd} lang="en" frPath="/contact/" enPath="/en/contact/">
<section class="hero hero--page wrap" style="padding-bottom:0">
  <div class="hero-top">
    <span class="hero-eyebrow reveal"><img width="918" height="832" src="/images/icon-orange.webp" alt="" /> Contact</span>
    <h1 class="reveal">Let's talk about <em>your visibility</em>.</h1>
    <p class="hero-sub reveal">30 minutes to see whether your market justifies an organic strategy — and what it could be worth. No obligation.</p>
  </div>
</section>

<!-- CONTACT GRID -->
<section class="sec">
  <div class="wrap contact-grid">
    <div class="contact-aside reveal">
      <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="contact-line" style="text-decoration:none">
        <span class="cl-ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg></span>
        <span><b>Book a call</b><span>30-min slot via Calendly →</span></span>
      </a>
      <a href="mailto:contact@advised-seo.fr" class="contact-line">
        <span class="cl-ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
        <span><b>Email</b><span>contact@advised-seo.fr</span></span>
      </a>
      <a href="https://www.linkedin.com/in/francisndimba" target="_blank" rel="noopener" class="contact-line">
        <span class="cl-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-4 0v6h-4v-6a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="11"/><circle cx="4" cy="4" r="2"/></svg></span>
        <span><b>LinkedIn</b><span>Francis Ndimba →</span></span>
      </a>
      <div class="note-card dark" style="margin-top:4px">
        <span class="kicker">The smart move</span>
        <h3 style="font-size:21px">Start with the Diagnostic</h3>
        <p>The ideal starting point: we quantify the opportunity before any decision on an engagement.</p>
      </div>
    </div>

    <form class="form reveal" onsubmit="return false">
      <div class="field">
        <label for="f-nom">Name</label>
        <input id="f-nom" type="text" name="name" placeholder="Your name" autocomplete="name" />
      </div>
      <div class="field">
        <label for="f-marque">Brand</label>
        <input id="f-marque" type="text" name="brand" placeholder="Your brand name" />
      </div>
      <div class="field">
        <label for="f-site">Website</label>
        <input id="f-site" type="url" name="site" placeholder="https://" autocomplete="url" />
      </div>
      <div class="field">
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" placeholder="Tell me about your brand and your goal…"></textarea>
      </div>
      <a href="mailto:contact@advised-seo.fr" class="btn btn--orange" id="sendBtn">Send
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <p style="font-size:12.5px;color:var(--ink-45);margin-top:14px;text-align:center">Or write directly to contact@advised-seo.fr — reply within 48h.</p>
    </form>
  </div>
</section>

<script is:inline>var sendBtn=document.getElementById("sendBtn");sendBtn&&sendBtn.addEventListener("click",function(m){var t=(document.getElementById("f-nom").value||"").trim(),e=(document.getElementById("f-marque").value||"").trim(),n=(document.getElementById("f-site").value||"").trim(),o=(document.getElementById("f-message").value||"").trim();if(!t&&!e&&!n&&!o){m.preventDefault(),document.getElementById("f-nom").focus();return}var a="AfriRank contact"+(e?" \u2014 "+e:""),d="Name: "+t+`
Brand: `+e+`
Site: `+n+`

`+o;sendBtn.setAttribute("href","mailto:contact@advised-seo.fr?subject="+encodeURIComponent(a)+"&body="+encodeURIComponent(d)),setTimeout(function(){window.location.href="/en/thank-you/"},800)});</script>
</Base>
