---
import Base from '../../layouts/Base.astro';
const calendly = 'https://calendly.com/contact-advised-seo/30min?back=1';
---
<Base
  title="SEO & GEO for African & Black-owned brands — AfriRank"
  description="Make your Black-owned brand visible on Google and in AI answers — for good, without depending on ads. Book a 30-min call, no commitment."
  lang="en"
  frPath="/offre-seo/"
  enPath="/en/seo-offer/"
  noindex={true}
  bare={true}>

<!-- Minimal header (no menu: campaign-only page) -->
<header class="lp-head">
  <div class="wrap lp-head-inner">
    <img src="/images/logo-dark.png" alt="AfriRank" class="lp-logo" />
    <a href={calendly} class="btn btn--blue lp-head-cta">Book my call
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
  </div>
</header>

<!-- HERO -->
<section class="hero hero--page wrap lp-hero">
  <div class="hero-top">
    <span class="hero-eyebrow reveal"><img src="/images/icon-orange.png" alt="" /> SEO &amp; GEO · African &amp; Black-owned brands</span>
    <h1 class="reveal">Your brand deserves to be <em>found</em> — on Google and in AI.</h1>
    <p class="hero-sub reveal">Paid ads are rent: you pay, you show up; you stop, you disappear. AfriRank builds organic visibility <strong>you own</strong>, rooted in your market and your culture.</p>
    <div class="lp-cta reveal">
      <a href={calendly} class="btn btn--orange">Book my 30-min call
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <span class="lp-cta-note">No commitment · reply within 48h</span>
    </div>
    <p class="lp-trust reveal">11 years of SEO expertise · Groupe SEB · LumApps · Rubix · Bonduelle · BPIFrance</p>
  </div>
</section>

<!-- WHAT YOU GET -->
<section class="sec lp-sec">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">What you get</span>
      <h2 class="sec-title">Lasting visibility, not an endless ad budget.</h2>
    </div>
    <div class="lp-benefits">
      <div class="lp-benefit reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18M7 14l4-4 3 3 5-6"/></svg></span>
        <h3>Traffic you own</h3>
        <p>An organic channel that keeps working when you switch the ads off.</p>
      </div>
      <div class="lp-benefit reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 7v5c0 4.5 3.4 7.5 8 9 4.6-1.5 8-4.5 8-9V7Z"/></svg></span>
        <h3>Cultural SEO</h3>
        <p>The vocabulary, intent and codes of your community — the things a generalist agency misses.</p>
      </div>
      <div class="lp-benefit reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></span>
        <h3>Visibility in AI (GEO)</h3>
        <p>Get cited by ChatGPT, Perplexity and Google AI — where buying decisions are now made.</p>
      </div>
      <div class="lp-benefit reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 7v5c0 4.5 3.4 7.5 8 9 4.6-1.5 8-4.5 8-9V7Z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <h3>A senior expert, one point of contact</h3>
        <p>Enterprise-grade expertise, accountable end to end — and who hands you the keys.</p>
      </div>
    </div>
  </div>
</section>

<!-- PROOF -->
<section class="sec lp-sec lp-proof">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">The proof</span>
      <h2 class="sec-title">Senior expertise, measurable.</h2>
    </div>
    <div class="stats">
      <div class="stat reveal"><div class="num">11 years</div><div class="lbl">of SEO experience — agency-side, then in-house</div></div>
      <div class="stat reveal"><div class="num">23 sites</div><div class="lbl">migrated in 2 years for Groupe SEB (technical SEO lead)</div></div>
      <div class="stat reveal"><div class="num">+59%</div><div class="lbl">more MQLs generated at LumApps (B2B SaaS)</div></div>
      <div class="stat reveal"><div class="num">300+</div><div class="lbl">AI-driven content pieces produced in 2 years</div></div>
    </div>
  </div>
</section>

<!-- OFFER / REASSURANCE + FINAL CTA -->
<section class="sec lp-sec">
  <div class="wrap">
    <div class="cta-band reveal">
      <img src="/images/icon-cream.png" class="icon-watermark" alt="" />
      <span class="kicker" style="color:var(--orange);justify-content:center">Where to start</span>
      <h2>The AfriRank Diagnostic.</h2>
      <p>30 minutes to see whether your market justifies an organic strategy — and to put a number on the organic revenue you're handing to your competitors today. No commitment.</p>
      <div class="cta-actions">
        <a href={calendly} class="btn btn--orange">Book my 30-min call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="mailto:contact@advised-seo.fr" class="btn btn--cream">contact@advised-seo.fr</a>
      </div>
    </div>
  </div>
</section>

<!-- Minimal footer (Ads compliance: brand + legal notice) -->
<footer class="lp-foot">
  <div class="wrap lp-foot-inner">
    <img src="/images/logo-dark.png" alt="AfriRank" class="lp-foot-logo" />
    <span>© 2026 AfriRank — Francis Ndimba</span>
    <a href="/en/legal-notice/">Legal notice</a>
    <a href="mailto:contact@advised-seo.fr">contact@advised-seo.fr</a>
  </div>
</footer>

<!-- Paid landing view (useful for audiences / remarketing in GTM) -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'lp_view', lp: 'seo-offer', page_path: location.pathname });
</script>
</Base>
