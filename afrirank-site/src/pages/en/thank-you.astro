---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Thank you — it's confirmed | AfriRank"
  description="Your request has been received. AfriRank will get back to you shortly to prepare your call."
  active=""
  lang="en"
  frPath="/merci/"
  enPath="/en/thank-you/"
  noindex={true}
  footerTagline="Thank you for your trust.">
<section class="hero hero--page wrap merci">
  <div class="hero-top">
    <span class="merci-badge reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
    <h1 class="reveal">Thank you — <em>it's confirmed</em>.</h1>
    <p class="hero-sub reveal">Your request has come through. If you've just booked a slot, a Calendly confirmation email (with the call link) is already on its way. Otherwise, I'll reply within 48 working hours.</p>
  </div>
</section>

<section class="sec" style="padding-top:clamp(24px,4vw,48px)">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="kicker">What's next</span>
      <h2 class="sec-title">What happens now.</h2>
    </div>
    <div class="merci-steps">
      <div class="merci-step reveal">
        <div class="ms-num">1</div>
        <h3>Email confirmation</h3>
        <p>You'll get a summary. Check your spam folder if nothing arrives within a few minutes.</p>
      </div>
      <div class="merci-step reveal">
        <div class="ms-num">2</div>
        <h3>I prep for the call</h3>
        <p>I take a look at your brand and your market before we speak, so we get straight to the point.</p>
      </div>
      <div class="merci-step reveal">
        <div class="ms-num">3</div>
        <h3>We quantify the opportunity</h3>
        <p>30 minutes to see what your organic visibility could really be worth — no obligation.</p>
      </div>
    </div>

    <div class="cta-band reveal" style="margin-top:clamp(40px,5vw,64px)">
      <img width="918" height="832" src="/images/icon-cream.webp" class="icon-watermark" alt="" />
      <h2>In the meantime, get to know AfriRank.</h2>
      <p>Discover the approach and the expertise behind the brand.</p>
      <div class="cta-actions">
        <a href="/en/" class="btn btn--orange">Back to home
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/en/about/" class="btn btn--cream">Who's behind AfriRank?</a>
      </div>
    </div>
  </div>
</section>

<!-- Conversion: fired after form submission or booking (use in GTM for GA4 + Google Ads) -->
<script is:inline>window.dataLayer=window.dataLayer||[],window.dataLayer.push({event:"conversion",conversion_type:"rdv_contact",page_path:location.pathname});</script>

<style>
  .merci .hero-top { text-align: center; max-width: 720px; margin: 0 auto; }
  .merci-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 76px; height: 76px; border-radius: 50%;
    background: var(--orange); color: #fff; margin-bottom: 28px;
    box-shadow: 0 16px 36px -14px rgba(207, 100, 53, .9);
  }
  .merci-badge svg { width: 38px; height: 38px; }
  .merci .hero-sub { margin-left: auto; margin-right: auto; }
  .merci-steps {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 28px);
  }
  .merci-step {
    background: #fff; border: 1px solid var(--line);
    border-radius: 20px; padding: clamp(24px, 2.6vw, 32px);
  }
  .ms-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--blue); color: var(--beige);
    font-family: var(--serif); font-size: 18px; margin-bottom: 16px;
  }
  .merci-step h3 { font-size: 19px; margin-bottom: 8px; }
  .merci-step p { color: var(--ink-60); font-size: 15.5px; line-height: 1.65; }
  @media (max-width: 760px) {
    .merci-steps { grid-template-columns: 1fr; }
  }
</style>
</Base>
