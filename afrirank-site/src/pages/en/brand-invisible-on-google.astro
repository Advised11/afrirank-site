      "publisher": { "@id": "https://www.afrirank.fr/#business" },
      "datePublished": "2026-07-16",
      "dateModified": "2026-07-17",
      "about": [
        { "@type": "Thing", "name": "Search engine indexing" },
        { "@type": "Thing", "name": "Technical SEO" },
        { "@type": "Thing", "name": "Google Search Console", "sameAs": "https://en.wikipedia.org/wiki/Google_Search_Console" },
        { "@type": "Thing", "name": "Site architecture" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.afrirank.fr/en/" },
        { "@type": "ListItem", "position": 2, "name": "Resellers ahead of your brand", "item": "https://www.afrirank.fr/en/resellers-capture-brand-traffic/" },
        { "@type": "ListItem", "position": 3, "name": "Brand invisible on Google", "item": "https://www.afrirank.fr/en/brand-invisible-on-google/" }
      ]
    },
