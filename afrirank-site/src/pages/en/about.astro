---
import Base from '../../layouts/Base.astro';
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["AboutPage", "ProfilePage"],
      "@id": "https://www.afrirank.fr/en/about/",
      "name": "About — Francis Ndimba, the SEO expert behind AfriRank",
      "url": "https://www.afrirank.fr/en/about/",
      "inLanguage": "en",
      "isPartOf": { "@id": "https://www.afrirank.fr/#website" },
      "about": { "@id": "https://www.afrirank.fr/#business" },
      "mainEntity": { "@id": "https://www.advised-seo.fr/#francis" }
    },
    {
      "@type": "Person",
      "@id": "https://www.advised-seo.fr/#francis",
      "name": "Francis Ndimba",
      "jobTitle": "Freelance SEO consultant",
      "url": "https://www.afrirank.fr/en/about/",
      "image": "https://www.afrirank.fr/images/francis-ndimba.webp",
      "worksFor": { "@id": "https://www.afrirank.fr/#business" },
      "knowsLanguage": ["en", "fr"],
      "knowsAbout": ["Technical SEO", "SEO migrations", "Semantic SEO", "GEO", "AEO", "Schema.org", "Cultural SEO"],
      "description": "SEO expert with 11 years' experience — agency-side then in-house (Groupe SEB, LumApps, Rubix). Founder of AfriRank.",
      "sameAs": ["https://www.linkedin.com/in/francisndimba"]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.afrirank.fr/en/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://www.afrirank.fr/en/about/" }
      ]
    }
  ]
});
---
<Base title="Francis Ndimba — the SEO expert behind AfriRank | 11 years" description="Francis Ndimba, 11 years of SEO agency-side and in-house (SEB, LumApps, Rubix). AfriRank puts that senior expertise to work for Black-owned brands." active="a-propos" jsonLd={jsonLd} lang="en" frPath="/a-propos/" enPath="/en/about/">
<section class="hero hero--page wrap">
  <div class="hero-top">
    <span class="hero-eyebrow reveal"><img width="918" height="832" src="/images/icon-orange.webp" alt="" /> About</span>
    <h1 class="reveal">The expertise usually reserved for big groups, <em>working for your brand</em>.</h1>
    <p class="hero-sub reveal">My name is Francis Ndimba. 11 years making sites rank — agency-side, then in-house, on projects few freelancers have led. AfriRank is that expertise, working for established African &amp; Black-owned brands.</p>
  </div>
</section>

<!-- THE TRACK RECORD -->
<section class="sec">
  <div class="wrap about-grid">
    <img width="500" height="500" src="/images/francis-ndimba.webp" alt="Francis Ndimba, SEO consultant and founder of AfriRank" class="about-photo reveal" loading="lazy" />
    <div class="reveal">
      <span class="kicker">The track record — the proof</span>
      <h2 style="font-size:clamp(28px,3.6vw,44px);margin-bottom:28px">11 years, heavy cases.</h2>
      <div class="timeline">
        <div class="tl-item">
          <h3>Groupe SEB</h3>
          <p>Technical SEO lead on the migration of <span class="tl-metric">23 sites in 2 years</span> (Tefal, Moulinex, Rowenta, Krups…).</p>
        </div>
        <div class="tl-item">
          <h3>LumApps <span style="font-size:15px;color:var(--ink-45);font-family:var(--sans);font-weight:400">(B2B SaaS)</span></h3>
          <p>Migration of 3 sites and an AI content strategy: <span class="tl-metric">+59% MQLs</span>, +30% impressions.</p>
        </div>
        <div class="tl-item">
          <h3>Rubix <span style="font-size:15px;color:var(--ink-45);font-family:var(--sans);font-weight:400">(industrial, international)</span></h3>
          <p>Multi-country migrations (UK · FR · DE · BeNeLux).</p>
        </div>
        <div class="tl-item">
          <h3>And also</h3>
          <p>Bonduelle, Arkema, BPIFrance, Isotoner, Galbani, Président…</p>
        </div>
      </div>
      <p class="proof-note" style="margin-top:30px">These brands aren't African-market. I say it on purpose: this is my senior track record, and I bring it intact to AfriRank.</p>
    </div>
  </div>
</section>

<!-- THE CONVICTION -->
<section class="sec offers">
  <div class="wrap">
    <div class="sec-head reveal" style="max-width:880px">
      <span class="kicker">Why AfriRank</span>
      <h2 class="sec-title">The conviction.</h2>
      <p>African &amp; Black-owned brands deserve their place on Google and in AI answers — not by luck or ad budget, but through a solid strategy rooted in their culture. I've seen too many strong brands hand their organic revenue to resellers with no story. AfriRank is enterprise-grade expertise paired with a native understanding of your market.</p>
    </div>
  </div>
</section>

<!-- THE VALUES -->
<section class="sec">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="kicker">How I work</span>
      <h2 class="sec-title">Four principles, kept.</h2>
    </div>
    <div class="values">
      <div class="value reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0M4 21v-1a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v1"/><circle cx="12" cy="7" r="0"/></svg></span>
        <div><h3>Peer to peer</h3><p>You built the brand; I know my craft. No needless jargon.</p></div>
      </div>
      <div class="value reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.5 3.4 7.5 8 9 4.6-1.5 8-4.5 8-9V7Z"/></svg></span>
        <div><h3>Senior, not an army</h3><p>One expert point of contact, accountable end to end.</p></div>
      </div>
      <div class="value reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24"><path d="M15 7h3a2 2 0 0 1 2 2v3M7 15v3M3 12V6a2 2 0 0 1 2-2h6M10 14l4-4M14 14l-4-4"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></span>
        <div><h3>I hand you the keys</h3><p>Know-how transferred to your team — no manufactured dependence.</p></div>
      </div>
      <div class="value reveal">
        <span class="v-ic"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l4-4 3 3 5-6"/></svg></span>
        <div><h3>Numbers, not promises</h3><p>We measure, we quantify, we adjust. The rest is noise.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="sec">
  <div class="wrap">
    <div class="cta-band reveal">
      <img width="918" height="832" src="/images/icon-cream.webp" class="icon-watermark" alt="" />
      <h2>Let's talk about your brand.</h2>
      <p>30 minutes to see whether your market justifies an organic strategy — and what it could be worth.</p>
      <div class="cta-actions">
        <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--orange">Book a call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="mailto:contact@advised-seo.fr" class="btn btn--cream">contact@advised-seo.fr</a>
      </div>
    </div>
  </div>
</section>
</Base>
