---
import Base from '../../layouts/Base.astro';
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.afrirank.fr/en/seo-services/#service",
      "name": "SEO & GEO services for established African & Black-owned brands",
      "serviceType": ["SEO", "GEO", "Cultural SEO"],
      "description": "Three tiers of SEO + GEO support for established African & Black-owned e-commerce brands, 6-month engagement, plus a fully bespoke option.",
      "url": "https://www.afrirank.fr/en/seo-services/",
      "inLanguage": "en",
      "provider": { "@id": "https://www.afrirank.fr/#business" },
      "areaServed": ["GB", "US", "FR", "Europe"],
      "availableLanguage": ["en", "fr"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AfriRank service tiers",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Starter",
            "description": "To lay solid organic foundations: prioritised SEO roadmap, essential technical fixes, 10–20 business-driving keywords, monthly follow-up.",
            "priceSpecification": { "@type": "UnitPriceSpecification", "price": 690, "priceCurrency": "EUR", "unitText": "month", "billingIncrement": 1 },
            "url": "https://www.afrirank.fr/en/seo-services/"
          },
          {
            "@type": "Offer",
            "name": "Growth",
            "description": "To grow organic acquisition into a real channel: technical and semantic implementation, SEO + GEO content production, category and product page optimisation, business-focused reporting.",
            "priceSpecification": { "@type": "UnitPriceSpecification", "price": 1490, "priceCurrency": "EUR", "unitText": "month", "billingIncrement": 1 },
            "url": "https://www.afrirank.fr/en/seo-services/"
          },
          {
            "@type": "Offer",
            "name": "Partner",
            "description": "To make SEO + GEO a major acquisition lever: high-volume content engine, dedicated GEO strategy, brand authority at scale, skills handover to your team.",
            "priceSpecification": { "@type": "UnitPriceSpecification", "price": 2490, "priceCurrency": "EUR", "unitText": "month", "billingIncrement": 1 },
            "url": "https://www.afrirank.fr/en/seo-services/"
          },
          {
            "@type": "Offer",
            "name": "Full (bespoke)",
            "description": "360° support built around your project: website creation/management, local and international SEO, branding, project management. Custom quote.",
            "url": "https://www.afrirank.fr/en/contact/"
          }
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.afrirank.fr/en/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.afrirank.fr/en/seo-services/" }
      ]
    }
  ]
});
---
<Base title="SEO & GEO services — AfriRank | 3 tiers for established brands" description="Three tiers of SEO + GEO support for established African & Black-owned e-commerce brands. 6-month engagement. From rollout to full skills handover." active="accompagnement" jsonLd={jsonLd} lang="en" frPath="/accompagnement/" enPath="/en/seo-services/">
<section class="hero hero--page wrap">
  <div class="hero-top">
    <span class="hero-eyebrow reveal"><img width="918" height="832" src="/images/icon-orange.webp" alt="" /> The services · 6-month engagement</span>
    <h1 class="reveal">Plans for every <em>stage of growth</em>.</h1>
    <p class="hero-sub reveal">Three tiers, 6-month engagement — the time SEO needs to deliver durable results — plus a fully bespoke option.</p>
    <div class="hero-actions reveal">
      <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--orange">Book a call
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="/en/seo-diagnostic/" class="btn btn--ghost">Start with the Diagnostic</a>
    </div>
  </div>
</section>

<!-- 3 TIERS -->
<section class="sec-sm">
  <div class="wrap">
    <div class="offer-detail">
      <div class="od reveal">
        <span class="od-tag">Starter</span>
        <h3>Starter</h3>
        <div class="price">€690<small style="font-family:var(--sans);font-size:14px;font-weight:400;opacity:.6"> / mo · ~$750</small></div>
        <span class="engage"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>6-month engagement</span>
        <p class="od-sub">To lay solid organic foundations.</p>
        <ul>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Prioritised SEO roadmap (from the Diagnostic)</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Essential technical fixes</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>10–20 revenue-driving keywords</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Monthly tracking &amp; adjustments</li>
        </ul>
        <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--ghost">Book a call</a>
      </div>

      <div class="od featured reveal">
        <span class="od-tag">Best fit</span>
        <h3>Growth</h3>
        <div class="price">€1,490<small style="font-family:var(--sans);font-size:14px;font-weight:400;opacity:.7"> / mo · ~$1,600</small></div>
        <span class="engage"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>6-month engagement</span>
        <p class="od-sub">To grow organic acquisition into a real channel.</p>
        <ul>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Everything in Starter + implementation (technical &amp; semantic)</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>SEO + GEO content production</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Category / product page optimisation</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Business-focused monthly reporting</li>
        </ul>
        <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--orange">Book a call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="od reveal">
        <span class="od-tag">Partner</span>
        <h3>Partner</h3>
        <div class="price">€2,490<small style="font-family:var(--sans);font-size:14px;font-weight:400;opacity:.6"> / mo · ~$2,700</small></div>
        <span class="engage"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>6-month engagement</span>
        <p class="od-sub">To make SEO + GEO a major acquisition lever.</p>
        <ul>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Everything in Growth + a high-volume content engine</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Dedicated GEO strategy (AI answers)</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Brand authority &amp; internal linking at scale</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Skills handover to your team</li>
        </ul>
        <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--ghost">Book a call</a>
      </div>
    </div>
  </div>
</section>

<!-- COMPARISON TABLE -->
<section class="sec-sm">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="kicker">Comparison</span>
      <h2 class="sec-title">What's included, tier by tier.</h2>
    </div>
    <div class="cmp-scroll reveal">
      <table class="cmp">
        <thead>
          <tr><th>Deliverable</th><th>Starter</th><th class="featured-col">Growth</th><th>Partner</th></tr>
        </thead>
        <tbody>
          <tr><th>Prioritised SEO roadmap</th><td><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td><td class="featured-col"><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td><td><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td></tr>
          <tr><th>Technical fixes</th><td>Essential</td><td class="featured-col">Full implementation</td><td>Full implementation</td></tr>
          <tr><th>Business keywords</th><td>10–20</td><td class="featured-col">Extended + semantic</td><td>High-volume</td></tr>
          <tr><th>SEO + GEO content production</th><td>—</td><td class="featured-col"><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td><td>High-volume engine</td></tr>
          <tr><th>Category / product optimisation</th><td>—</td><td class="featured-col"><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td><td><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td></tr>
          <tr><th>Dedicated GEO strategy (AI answers)</th><td>—</td><td class="featured-col">Included in content</td><td>Dedicated</td></tr>
          <tr><th>Brand authority &amp; linking</th><td>—</td><td class="featured-col">—</td><td><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td></tr>
          <tr><th>Skills handover</th><td>—</td><td class="featured-col">—</td><td><span class="yes"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg></span></td></tr>
          <tr><th>Reporting</th><td>Monthly tracking</td><td class="featured-col">Business-focused</td><td>Business-focused</td></tr>
          <tr><th>Indicative price / mo</th><td>€690 (~$750)</td><td class="featured-col">€1,490 (~$1,600)</td><td>€2,490 (~$2,700)</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- FULL -->
<section class="sec-sm">
  <div class="wrap">
    <div class="audit-card reveal">
      <div class="audit-left">
        <span class="offer-tag">Full · Bespoke</span>
        <h2>360° support.</h2>
        <p>When the scope goes beyond SEO alone: website build and management, local &amp; international SEO, branding, project management. Built around your brand.</p>
        <ul class="audit-list">
          <li><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg>Website build / management</li>
          <li><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg>Local &amp; international SEO</li>
          <li><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg>Branding &amp; storytelling</li>
          <li><svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5"/></svg>Project management</li>
        </ul>
      </div>
      <div class="audit-right">
        <div class="audit-price" style="font-size:clamp(34px,4vw,44px)">On request<span>scope tailored</span></div>
        <a href="/en/contact/" class="btn btn--orange">Request a quote
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <span class="audit-note">Reply within 48h.</span>
      </div>
    </div>
  </div>
</section>

<!-- THE MECHANICS -->
<section class="sec problem">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="kicker">How it works</span>
      <h2 class="sec-title">For you, with you,<br />then on your own.</h2>
      <p>I start by doing it <strong>for you</strong>, then <strong>with you</strong>, and I train your team to keep the reins. It's the opposite of an agency that keeps you dependent.</p>
    </div>
    <div class="mech">
      <div class="mech-step reveal"><div class="ms-num">01</div><h3>For you</h3><p>I execute the strategy, the fixes and the content. You see results before you lift a finger.</p></div>
      <div class="mech-step reveal"><div class="ms-num">02</div><h3>With you</h3><p>We work side by side: your team takes ownership of the method, the tools and the trade-offs.</p></div>
      <div class="mech-step reveal"><div class="ms-num">03</div><h3>On your own</h3><p>I hand you the keys. The know-how stays with you, not with the provider.</p></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="sec">
  <div class="wrap">
    <div class="cta-band reveal">
      <img width="918" height="832" src="/images/icon-cream.webp" class="icon-watermark" alt="" />
      <h2>We start with the Diagnostic.</h2>
      <p>The diagnostic quantifies the opportunity and leads to the right-tier recommendation. Signing up becomes the logical next step, not a gamble.</p>
      <div class="cta-actions">
        <a href="https://calendly.com/contact-advised-seo/30min?back=1" target="_blank" rel="noopener" class="btn btn--orange">Book my Diagnostic
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/en/seo-diagnostic/" class="btn btn--cream">See the Diagnostic</a>
      </div>
    </div>
  </div>
</section>
</Base>
