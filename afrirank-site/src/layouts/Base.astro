---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/afrirank-motifs.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active?: string;
  jsonLd?: string;
  footerTagline?: string;
  noindex?: boolean;
  bare?: boolean;
  lang?: string;
  frPath?: string;
  enPath?: string;
}
const { title, description, active = '', jsonLd = '', footerTagline, noindex = false, bare = false, lang = 'fr', frPath, enPath } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
// La langue "autre" pour le sélecteur de langue de la navigation
const altPath = lang === 'fr' ? enPath : frPath;
const thanksPath = lang === 'en' ? '/en/thank-you/' : '/merci/';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google Tag Manager -->
  <script is:inline>(function(t,n,r,e,m){t[e]=t[e]||[],t[e].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var g=n.getElementsByTagName(r)[0],a=n.createElement(r),s=e!="dataLayer"?"&l="+e:"";a.async=!0,a.src="https://www.googletagmanager.com/gtm.js?id="+m+s,g.parentNode.insertBefore(a,g)})(window,document,"script","dataLayer","GTM-MMWLNDWP");</script>
  <!-- End Google Tag Manager -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  {frPath && <link rel="alternate" hreflang="fr-FR" href={abs(frPath)} />}
  {enPath && <link rel="alternate" hreflang="en" href={abs(enPath)} />}
  {frPath && <link rel="alternate" hreflang="x-default" href={abs(frPath)} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="/images/logo-dark.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/images/icon-orange.png" />
  <link rel="preload" href="/fonts/lora-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body data-thanks={thanksPath}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMWLNDWP"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  {!bare && <Nav active={active} lang={lang} altPath={altPath} />}
  <slot />
  {!bare && <Footer tagline={footerTagline} lang={lang} />}

  <script is:inline>(function(){var t=document.getElementById("nav");if(t){var o=function(){t.classList.toggle("scrolled",window.scrollY>12)};o(),window.addEventListener("scroll",o,{passive:!0})}var i=document.getElementById("navToggle");i&&(i.addEventListener("click",function(){document.body.classList.toggle("menu-open")}),document.querySelectorAll("#mobileMenu a").forEach(function(e){e.addEventListener("click",function(){document.body.classList.remove("menu-open")})}));var a=document.querySelectorAll(".reveal"),s=new IntersectionObserver(function(e){e.forEach(function(n){n.isIntersecting&&(n.target.classList.add("in"),s.unobserve(n.target))})},{threshold:.12,rootMargin:"0px 0px -8% 0px"});a.forEach(function(e,n){e.style.transitionDelay=Math.min(n%5,4)*60+"ms",s.observe(e)});var c=function(){a.forEach(function(e){e.classList.contains("in")||(e.style.transition="none",e.classList.add("in"))})};setTimeout(c,1400),window.addEventListener("load",function(){setTimeout(c,400)}),document.querySelectorAll(".faq-q").forEach(function(e){e.addEventListener("click",function(){var n=e.parentElement,r=n.querySelector(".faq-a"),u=n.classList.contains("open");document.querySelectorAll(".faq-item.open").forEach(function(l){l.classList.remove("open"),l.querySelector(".faq-a").style.maxHeight=null}),u||(n.classList.add("open"),r.style.maxHeight=r.scrollHeight+"px")})})})();</script>

  <!-- dataLayer : suivi des CTA (réservation Calendly + clic email) -->
  <script is:inline>(function(){window.dataLayer=window.dataLayer||[],document.addEventListener("click",function(e){var a=e.target&&e.target.closest?e.target.closest("a"):null;if(a){var r=a.getAttribute("href")||"",n=(a.textContent||"").replace(/\s+/g," ").trim().slice(0,80),t=null;r.indexOf("calendly.com")!==-1?t="reservation":r.indexOf("mailto:")===0&&(t="email"),t&&window.dataLayer.push({event:"cta_click",cta_type:t,cta_label:n,cta_url:r,page_path:location.pathname})}},!0)})();</script>

  <!-- Calendly : ouverture en popup + redirection vers /merci/ après réservation -->
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline>(function(){document.addEventListener("click",function(t){var e=t.target&&t.target.closest?t.target.closest("a"):null;if(e){var n=e.getAttribute("href")||"";n.indexOf("calendly.com")!==-1&&window.Calendly&&typeof window.Calendly.initPopupWidget=="function"&&(t.preventDefault(),window.Calendly.initPopupWidget({url:n}))}}),window.addEventListener("message",function(t){typeof t.origin=="string"&&t.origin.indexOf("calendly.com")===-1||t.data&&t.data.event==="calendly.event_scheduled"&&(window.location.href=document.body&&document.body.dataset&&document.body.dataset.thanks||"/merci/")})})();</script>
</body>
</html>
